    {
      "id": "coupland-lodge",
      "name": "租屋",
      "place": "Coupland Street vicinity, Manchester",
      "years": "1909–1911",
      "kind": "lodge",
      "labId": null,
      "dialogue": [
        {
          "id": "lodge-1",
          "speaker": "华生",
          "speakerRole": "companion",
          "charId": "char-watson",
          "emotion": "think",
          "pose": "sit-stool",
          "text": "夜里把白天的数摊开：枣糕模型对大角说不通。中心电荷那张图，才对得上屏上那几道闪光。",
          "claim": {
            "source_tier": "interpretation",
            "citation": "Lodge night review — teaching synthesis; fact-ruth1911-plum-pudding-fails-large-angle",
            "notes": "租屋复盘压缩史实；演绎。"
          },
          "interpretation": true
        },
        {
          "id": "lodge-2",
          "speaker": "卢瑟福",
          "speakerRole": "scientist",
          "charId": "char-rutherford",
          "emotion": "idle",
          "pose": "sit-chair",
          "text": "大角很少，可绝不是零。把中心电荷摆进去，那几道闪光才有地方放。",
          "claim": {
            "source_tier": "interpretation",
            "citation": "Lodge night review — aligned to fact-gm1909-diffuse-reflection + fact-ruth1911-central-charge",
            "notes": "删盖革说话人后由卢瑟福收束实验印象。"
          },
          "interpretation": true
        },
        {
          "id": "lodge-3",
          "speaker": "旁白",
          "speakerRole": "narrator",
          "emotion": "idle",
          "text": "租屋里先把账对清。明天回实验室，箔厚和角分布还要接着验。",
          "claim": {
            "source_tier": "interpretation",
            "citation": "Lodge night review bridge — replaces former char-geiger stub",
            "notes": "盖革立绘已砍；本句改为旁白转场，实验史实仍可在他处提盖革&马斯登工作。"
          },
          "interpretation": true
        }
      ],
