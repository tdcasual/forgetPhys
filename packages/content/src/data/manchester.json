      "dialogue": [
        {
          "id": "mcr-1",
          "speaker": "华生",
          "speakerRole": "companion",
          "charId": "char-watson",
          "emotion": "think",
          "pose": "stand",
          "text": "一九〇九年，Coupland Street 暗室。盖革和马斯登对着硫化锌屏数闪光——绝大多数 α 几乎贴着前进方向穿过去。",
          "claim": {
            "source_tier": "primary",
            "citation": "H. Geiger & E. Marsden, Proc. R. Soc. A 82 (1909) 495–500",
            "notes": "cite fact-gm1909-paper / fact-gm1909-zns-method / fact-gm1909-forward-majority。提盖革&马斯登工作，不出场。"
          }
        },
        {
          "id": "mcr-2",
          "speaker": "卢瑟福",
          "speakerRole": "scientist",
          "charId": "char-rutherford",
          "emotion": "speak",
          "pose": "sit-chair",
          "text": "可是有少数偏得很厉害，有的简直折回来。他们管这叫漫反射。闪光是他们数的；我这边要把账说圆。",
          "claim": {
            "source_tier": "primary",
            "citation": "H. Geiger & E. Marsden, Proc. R. Soc. A 82 (1909) 495–500",
            "notes": "cite fact-gm1909-diffuse-reflection。VoiceCard: 归功助手 + 实验室主任腔。"
          }
        },
        {
          "id": "mcr-3",
          "speaker": "卢瑟福",
          "speakerRole": "scientist",
          "charId": "char-rutherford",
          "emotion": "speak",
          "pose": "point-screen",
          "text": "先当工作假说：集中的中心电荷——原子中间一块很小的正电。大角主要靠这一下说得通。",
          "claim": {
            "source_tier": "primary",
            "citation": "E. Rutherford, Phil. Mag. 21 (1911) 669–688",
            "notes": "cite fact-ruth1911-central-charge。1909 暗室当下口吻（工作假说）；不剧透「一九一一年论文已写定」。对话用中心电荷，不用 nucleus 旗号。"
          }
        },
        {
          "id": "mcr-4",
          "speaker": "华生",
          "speakerRole": "companion",
          "charId": "char-watson",
          "emotion": "speak",
          "pose": "point-screen",
          "text": "后人爱讲「十五英寸炮弹打在薄纸上」——那是事后回忆，不是一九〇九年暗室里的原话。要不要自己上实验台扫一轮？",
          "claim": {
            "source_tier": "interpretation",
            "citation": "Late recollection (often 1930s); era-op-shell-metaphor-late",
            "notes": "D 级戏剧许可。勿当 1909 现场史实。"
          },
          "interpretation": true
        },
        {
          "id": "mcr-5",
          "speaker": "旁白",
          "speakerRole": "narrator",
          "emotion": "idle",
          "text": "教材把这叫做原子的核式结构：质量和正电荷几乎都挤在很小的中心，电子在外围。枣糕模型解释不了那些大角偏转。",
          "claim": {
            "source_tier": "textbook",
            "citation": "人教版选必三 第四§3–§4（教材用语：核式结构）",
            "notes": "教材词仅旁白；与 era-op-nucleus-word-anachronism 对齐。"
          }
        }
      ],
