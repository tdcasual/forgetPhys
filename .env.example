# Server-only secrets — NEVER commit real values; NEVER put these in VITE_*.
# Copy to .env (gitignored) for local BFF → DeepSeek / LiteLLM.

DEEPSEEK_API_KEY=
LITELLM_MODEL=deepseek/deepseek-chat
LITELLM_BASE_URL=https://api.deepseek.com

# Optional: if proxying via a local LiteLLM gateway instead of DeepSeek direct,
# set LITELLM_BASE_URL to the gateway (e.g. http://127.0.0.1:4000) and use:
# LITELLM_API_KEY=
# LITELLM_MODEL=forgetphys-debate

# Optional: canned SSE without upstream (tests / offline)
# DEBATE_BFF_MOCK=1
